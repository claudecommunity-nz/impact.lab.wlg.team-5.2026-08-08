# Server-side only. Needed by the Council console's PATCH route, which calls
# gold.advance_status — the one thing anon is deliberately refused.
#
# NEVER commit this, never ship it to a browser, never paste it into a chat.
# Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed to push migrations from the CLI. Session pooler, port 5432.
# Dashboard → Connect → Session pooler.
SUPABASE_DB_URL=
